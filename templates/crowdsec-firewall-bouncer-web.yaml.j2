# web-ban bouncer — handles HTTP-attack decisions (web-scope only)
# Decision type: web-ban — emitted by profiles.yaml for custom HTTP-attack scenarios
#   (11 built-in role scenarios + sportsight-* stack-defined HTTP scenarios)
# Port scope: tcp dport {80, 443} ONLY — SSH (22) is NOT affected by web-ban decisions.
# Default bouncer (crowdsec-firewall-bouncer) handles type: ban (all-ports)
#   for SSH brute-force (crowdsecurity/sshd) and manual ip_blocklist entries.
#
# set-only: true — bouncer writes IPs into the pre-created sets in the
#   crowdsec-web table (deployed by nftables-crowdsec-web.conf.j2 via ExecStartPre).
#   The port-scoped drop rule lives in that table; the bouncer never manages rules.
#   Set names must match exactly: crowdsec-blacklists / crowdsec6-blacklists
#   (no suffix mangling — suffixing only occurs in managed/non-set-only mode).
#
# This file is managed by Ansible (trellis-crowdsec v0.9.5 Path B).
# Do not edit manually — changes will be overwritten on provision.

mode: nftables
log_mode: file
log_dir: /var/log/
log_level: info
api_url: http://127.0.0.1:8080/
api_key: {{ crowdsec_web_bouncer_api_key }}
update_frequency: 10s
supported_decisions_types:
  - web-ban
deny_action: DROP
blacklists_ipv4: crowdsec-blacklists
blacklists_ipv6: crowdsec6-blacklists
nftables:
  ipv4:
    enabled: true
    set-only: true
    table: crowdsec-web
  ipv6:
    enabled: true
    set-only: true
    table: crowdsec-web
prometheus:
  enabled: false
  listen_addr: 127.0.0.1
  listen_port: 60602
