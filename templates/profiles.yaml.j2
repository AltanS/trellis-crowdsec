# CrowdSec Profiles Configuration
# Managed by Ansible - do not edit manually
#
# Profiles determine what action to take when a scenario triggers.
# They are evaluated in order; first match wins (on_success: break).
#
# Two-bouncer design (v0.9.4 Path B):
#   web-ban  — emitted by the 11 custom HTTP-attack scenario profiles below
#              (when crowdsec_web_scope_http_bans: true).
#              Enforced by crowdsec-firewall-bouncer-web: tcp dport {80,443} only.
#              SSH (port 22) is NOT affected by web-ban decisions.
#              Since v0.9.8 the default catch-all emits web-ban too, so a Hub
#              HTTP scenario (http-probing, http-cve, ...) or a stack's custom
#              HTTP scenario can never cut SSH or the tailnet transport.
#   ban      — emitted only by the ssh_scenarios profile (crowdsecurity/ssh-*).
#              Enforced by the default crowdsec-firewall-bouncer: all ports.
#              Manual ip_blocklist entries and `cscli decisions add` also land here.
#
# When crowdsec_web_scope_http_bans: false, every profile below emits type: ban
# (all ports), the v0.9.3 behavior.

{% if crowdsec_scenario_actuator_probe | bool %}
# -----------------------------------------------------------------------------
# Actuator Probe - Spring Boot endpoint scanning
# -----------------------------------------------------------------------------
name: actuator_probe
filters:
  - Alert.Remediation == true && Alert.GetScenario() == "custom/actuator-probe"
decisions:
{% if crowdsec_web_scope_http_bans | bool %}
  - type: web-ban
{% else %}
  - type: ban
{% endif %}
    duration: {{ crowdsec_scenario_actuator_probe_ban }}
on_success: break
---
{% endif %}
