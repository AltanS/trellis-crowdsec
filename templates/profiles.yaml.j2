{% if crowdsec_web_scope_http_bans | bool %}
# -----------------------------------------------------------------------------
# Stack-defined custom HTTP-attack scenarios (sportsight-* series)
# These scenarios are deployed via crowdsec_custom_scenarios in each stack's
# security.yml. Their decisions fall through to default_ip_remediation if no
# profile matches them by scenario name. With web-scope enabled, we capture
# them here before the catch-all so they get web-ban (not all-ports ban).
# All are HTTP-layer scenarios (service: http label, filter on http_path/http_args).
# -----------------------------------------------------------------------------
name: sportsight_custom_http_scenarios
filters:
  - Alert.Remediation == true && (Alert.GetScenario() == "custom/sportsight-go-enum" || Alert.GetScenario() == "custom/sportsight-cidr-aggregator" || Alert.GetScenario() == "custom/sportsight-gateway-probe" || Alert.GetScenario() == "custom/sportsight-archive-probe" || Alert.GetScenario() == "custom/sportsight-env-probe" || Alert.GetScenario() == "custom/sportsight-ssrf-probe")
decisions:
  - type: web-ban
    duration: {{ crowdsec_ban_duration_default }}
on_success: break
---
{% endif %}
{% if crowdsec_web_scope_http_bans | bool %}
# -----------------------------------------------------------------------------
# SSH scenarios - the only Hub scenarios that keep the all-ports ban
# -----------------------------------------------------------------------------
# An SSH brute-force source is hostile on every port, so it stays type: ban.
# Everything else that reaches the catch-all below is an HTTP scenario.
name: ssh_scenarios
filters:
  - Alert.Remediation == true && Alert.GetScope() == "Ip" && ({% for prefix in crowdsec_ssh_scenario_prefixes %}Alert.GetScenario() startsWith "{{ prefix }}"{% if not loop.last %} || {% endif %}{% endfor %})
decisions:
  - type: ban
    duration: {{ crowdsec_ban_duration_default }}
on_success: break
---
{% endif %}
# -----------------------------------------------------------------------------
# Default - All other scenarios (CrowdSec Hub + stack custom scenarios)
# -----------------------------------------------------------------------------
# With web scope on, these are HTTP scenarios (the SSH ones matched above), so
# the ban is port-scoped to 80/443. Before v0.9.8 this was type: ban on all
# ports: one false-positive http-probing alert dropped every packet from the
# source, including SSH and the Tailscale UDP transport, so the tailnet
# whitelist never saw the connection.
name: default_ip_remediation
filters:
  - Alert.Remediation == true && Alert.GetScope() == "Ip"
decisions:
{% if crowdsec_web_scope_http_bans | bool %}
  - type: web-ban
{% else %}
  - type: ban
{% endif %}
    duration: {{ crowdsec_ban_duration_default }}
on_success: break
